generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Post {
  id          Int      @id @default(autoincrement())
  crop        String
  grade       String
  quantity    String
  price       Float
  rating      Float    @default(4.5)
  isPredicted Boolean  @default(false)
  createdAt   DateTime @default(now())
}
